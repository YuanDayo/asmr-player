<?xml version="1.0" encoding="utf-8"?>
<!-- 不导出任何应用数据：WebView Cookie 库含 DLsite 登录态 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
